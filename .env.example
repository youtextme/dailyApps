# Local OpenAI-compatible router (Ollama / tireless-router / vLLM)
TIRELESS_LLM_BASE_URL=http://127.0.0.1:11434/v1
TIRELESS_LLM_API_KEY=local
TIRELESS_LLM_MODEL=llama3.2
TIRELESS_LLM_TIMEOUT=120

# Slack Socket Mode
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=
SLACK_DAILYAPPS_CHANNEL=dailyApps

# Optional GitHub gists (falls back to local data/gists/)
GITHUB_TOKEN=
TIRELESS_GIST_PUBLIC=1

# Runtime
TIRELESS_MAX_PARALLEL=20
TIRELESS_DATA_DIR=
DAILYAPPS_PAGES_URL=https://youtextme.github.io/dailyApps
