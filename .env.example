# dailyApps secrets contract — safe to commit. Copy to .env.local and fill values.
# Never commit .env.local, .env, or .envrc with real values.
#
# Setup: cp .env.example .env.local
# Verify: ./scripts/check-secrets.sh

# --- Slack (tireless-router bot + dailyApps channel) ---
# Create app: https://api.slack.com/apps → Create New App → From scratch
# Bot token: OAuth & Permissions → Bot User OAuth Token (xoxb-...)
# App token:  Basic Information → App-Level Tokens → generate with connections:write (xapp-...)
# Signing:   Basic Information → Signing Secret
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me
SLACK_SIGNING_SECRET=replace-me

# Channel for dailyApps prompts (optional; tireless may default to #dailyApps)
SLACK_CHANNEL_ID=
SLACK_DAILYAPPS_CHANNEL=dailyApps

# --- GitHub (Pages deploy, PR automation) ---
# Fine-grained or classic PAT with repo + workflow scope
GITHUB_TOKEN=ghp_replace-me
TIRELESS_GIST_PUBLIC=1

# --- LLM / tireless-router (local objective runner) ---
# Paths and keys depend on your tirelessLocalLLM workspace layout
TIRELESS_ROUTER_URL=http://127.0.0.1:8080
TIRELESS_LLM_BASE_URL=http://127.0.0.1:11434/v1
TIRELESS_LLM_API_KEY=local
TIRELESS_LLM_MODEL=llama3.2
TIRELESS_LLM_TIMEOUT=120
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Runtime ---
TIRELESS_MAX_PARALLEL=20
TIRELESS_DATA_DIR=
DAILYAPPS_PAGES_URL=https://youtextme.github.io/dailyApps